# How to obtain each of these, and what breaks without it: docs/setup.md
#
# Everything under "Optional" is gated inert — unset means the feature says
# "X is not configured" rather than crashing.

# --- Required ---------------------------------------------------------------

# Postgres (local, or Neon via the Vercel Marketplace). The app boots with this
# unset; DB access is lazy-init and only needed on persistence-backed routes.
DATABASE_URL=postgres://user:password@localhost:5432/emergent_clone

# Vercel Sandbox — where every generated app installs and runs. No fallback:
# with any of the three missing, builds fail (isVercelSandboxConfigured,
# src/server/sandbox-vercel-config.ts). VERCEL_TOKEN/TEAM_ID also drive the
# "Deploy Your Application" button.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Cloudflare R2 — file bytes ("R2 = bytes, DB = index"). All four; a build
# snapshot with these unset throws rather than storing rows pointing at nothing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# LLM providers — at least one. Models whose key is missing are hidden from the
# composer's model picker. OPEN_AI_KEY is accepted as an alias for the first.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Clerk auth. Required in EVERY environment, dev included — there is no
# unauthenticated mode. Missing keys make every request throw rather than
# silently serving the app with auth disabled (src/lib/auth.ts).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Neon per-app databases (one Neon project per project, one branch per session).
# Required: generated apps need one for persistence and accounts, and without it
# the agent is never told a database exists — so it would build fake logins.
NEON_API_KEY=
# NEON_REGION=      # optional, default aws-ap-southeast-1
# NEON_ORG_ID=      # optional, only when the API key spans several orgs

# --- Optional ---------------------------------------------------------------

# Scripted mock trajectory instead of real model calls.
# MOCK_AGENT=1

# GitHub "Save". ID + key enable it; CLIENT_ID/SECRET only add the OAuth token
# that lets personal-account (non-org) users create brand-new repos.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# Razorpay "Buy Credits" (INR). Without the webhook secret, purchases never
# grant credits even with the key pair set — the webhook is the only path that
# ever grants them.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
