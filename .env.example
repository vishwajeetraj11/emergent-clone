# Postgres connection string (local Postgres or Neon via Vercel Marketplace).
# The app boots and renders fine with this unset — DB access is lazy-init
# and only required once persistence-backed routes are hit.
DATABASE_URL=postgres://user:password@localhost:5432/emergent

# The real (non-mock) agent loop runs on the Claude Agent SDK, which wraps
# the local `claude` CLI and uses whatever the CLI is already logged in as
# (Claude Code subscription auth via `claude login`) — no API key needed for
# local dev. ANTHROPIC_API_KEY is NOT read by the agent loop and does not
# need to be set. Set MOCK_AGENT=1 to run the scripted mock trajectory
# instead (no model calls, no CLI required).
# MOCK_AGENT=1
